{
  "id": "goal-calendar",
  "name": "Goals",
  "description": "Calendar & tracking",
  "version": "0.2.0",
  "manifestVersion": 1,
  "compatibility": {
    "nucleus": ">=0.1.0 <1.0.0"
  },
  "route": "/goals",
  "icon": "icon.svg",
  "category": "productivity",
  "hub": {
    "showInSidebar": true,
    "showOnDashboard": true
  },
  "nginx": {
    "routes": [
      {
        "path": "/goals",
        "upstream": "goal-calendar:5175",
        "websocket": true
      },
      {
        "path": "/api/goals",
        "upstream": "goal-calendar-server:3001"
      }
    ]
  },
  "server": {
    "service": "goal-calendar-server",
    "port": 3001,
    "env": {
      "MONGODB_URI": "mongodb://mongo:27017/nucleus",
      "JWT_SECRET": "${JWT_SECRET:-nucleus-jwt-secret}"
    },
    "depends": [
      "mongo"
    ],
    "bindMounts": [
      "../core:/app/core:ro"
    ],
    "healthEndpoint": "/api/goals/health"
  }
}
